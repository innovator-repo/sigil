<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Shared with the other Lume apps; only apps signed with the same key can hold it. -->
    <permission
        android:name="app.lume.permission.ECOSYSTEM_SYNC"
        android:protectionLevel="signature" />
    <uses-permission android:name="app.lume.permission.ECOSYSTEM_SYNC" />

    <queries>
        <package android:name="app.kasane" />
        <package android:name="app.katachi" />
        <package android:name="app.ren.japanese" />
        <package android:name="com.vow.app" />
        <package android:name="com.duolingo" />
    </queries>

    <application
        android:name=".SigilApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Sigil"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Sigil"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- sigil://note/quick, sigil://note/diary, sigil://action/scrub-clipboard: each asks for the biometric check first. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sigil" android:host="note" android:path="/quick" />
                <data android:scheme="sigil" android:host="note" android:path="/diary" />
                <data android:scheme="sigil" android:host="action" android:path="/scrub-clipboard" />
            </intent-filter>
        </activity>

        <!--
          Autofill: offers Sigil's logins on any sign-in page or app login screen once it is
          chosen in Settings → Passwords & accounts. Only the system can bind to it.
        -->
        <service
            android:name=".autofill.SigilAutofillService"
            android:exported="true"
            android:label="@string/autofill_service_label"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/sigil_autofill_service" />
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
        </service>

        <!-- The fingerprint check between choosing a row and the password being filled in. -->
        <activity
            android:name=".autofill.AutofillFillActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Sigil"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
