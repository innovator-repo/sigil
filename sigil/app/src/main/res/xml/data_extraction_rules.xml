<?xml version="1.0" encoding="utf-8"?>
<!--
  Sigil holds passwords and other secrets, so nothing is eligible for cloud backup or
  device-to-device transfer - the Android Keystore key those secrets are encrypted with
  never leaves this device, so a restored blob would be undecryptable anyway.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="true">
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
